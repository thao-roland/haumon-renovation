{
  "name": "haumont-renovation",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine multi-pages de Haumont Rénovation SRL — HTML5, Tailwind CSS, JavaScript natif.",
  "scripts": {
    "dev": "tailwindcss -i assets/css/src.css -o assets/css/site.css --watch",
    "build:css": "tailwindcss -i assets/css/src.css -o assets/css/site.css --minify",
    "build": "node scripts/build.mjs",
    "serve": "python3 -m http.server 8000",
    "preview": "python3 -m http.server 8001 --directory dist"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
